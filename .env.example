# Local / cloud configuration example
# Reference for environment variables. The app does not load .env automatically.
# Set these in the launching process, or use .streamlit/secrets.toml.
# Do not commit real secrets.

# Access codes
QUIZ_LEARNER_CODE=MONCODE2026
QUIZ_TRAINER_PASSWORD=
# Set a personal trainer password. Empty means trainer access is disabled.

# Database mode
# sqlite = local database
# postgres = Supabase/PostgreSQL database
APP_DATABASE_MODE=sqlite

# Local SQLite database path
SQLITE_DB_PATH=data/quiz_history.db

# Supabase / PostgreSQL connection string when APP_DATABASE_MODE=postgres
# Example format:
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Reserved legacy setting; currently not read by the application
PUBLIC_APP_URL=
